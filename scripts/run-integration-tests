# See LICENSE file for licensing details.
#
# Single entry point for the integration suite, so CI and local runs stay in
# sync. Every argument is forwarded to pytest, e.g.
#
#   ./scripts/run-integration-tests --charm ./microcloud_amd64.charm
#   ./scripts/run-integration-tests --charm ./m.charm --no-juju-teardown -k status
#
# Requires a bootstrapped Juju controller on the current context.

exec tox -e integration -- "$@"
